---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/site';
---
<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지를 찾을 수 없습니다." noindex>
  <section class="container section nf">
    <h1>페이지를 찾을 수 없습니다</h1>
    <p>주소가 바뀌었거나 삭제된 페이지입니다.</p>
    <p><a href={href('/')}>홈으로 돌아가기</a></p>
  </section>
</BaseLayout>

<style>
  .nf { text-align: center; min-height: 40vh; }
  .nf h1 { font-size: 1.5rem; }
</style>
